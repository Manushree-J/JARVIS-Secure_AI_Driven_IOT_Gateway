# Copy this file to .env and supply values for services you enable.
# Never commit .env or any real credential.

# ElevenLabs text-to-speech (required for speech.py)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=pcm_24000

# Local text model via Ollama / its OpenAI-compatible endpoint
QWEN_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Ollama normally accepts a placeholder key for its local OpenAI-compatible API.
OLLAMA_API_KEY=ollama
QWEN_REQUEST_TIMEOUT=90
QWEN_MAX_RETRIES=2

# MQTT broker used by the ESP32 integration
JARVIS_MQTT_BROKER=127.0.0.1
JARVIS_MQTT_PORT=1883
JARVIS_ESP32_STALE_SECONDS=15
JARVIS_MQTT_VERBOSE=0

# Optional cloud-backed image analysis. The separate local YOLO skill needs no API key.
OPENROUTER_API_KEY=your_optional_vision_api_key
JARVIS_VISION_MODEL=google/gemini-2.5-flash-lite
