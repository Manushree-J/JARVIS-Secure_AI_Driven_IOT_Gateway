# ============================================================
# JARVIS .gitignore
# ============================================================

# Environment files
.env
*.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Local Android/Gradle configuration and build output
local.properties
.gradle/
**/.gradle/
**/build/
*.apk
*.aab

# Local credentials and private keys
client_secrets.json
credentials.json
*_key.txt
*.pem
*.key

# Local databases, vaults, and generated state
jarvis_memory/
**/jarvis_memory/
Conversations/
**/Conversations/
Personal/
**/Personal/
*.sqlite
*.sqlite3
*.db
*.pickle
*.pkl

# Editor/runtime scratch files
*.bak
*.backup
*.retired
*.broken
*.orig
*.rej
*.patch
*.lnk
CLEANUP_PLAN.md

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
temp_*
*.webm
*.wav

# Large model files (keep local copies, don't commit)
*.onnx
*.onnx.json

# ChromaDB
jarvis_memory/

# Python cache in nested directories
**/__pycache__/
**/*.py[cod]

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Voice assistant temporary files
temp_*.webm
temp_*.wav

# Google OAuth tokens and credentials
client_secrets.json
tokens/
google_token.pkl
gmail_token.pkl
calendar_token.pkl
*.pkl